<?xml version="1.0" encoding="utf-8"?>
<!-- CI-only helper: observes the SYSTEM clipboard and Android AUTOFILL requests so E2E can detect leaks. Never shipped. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.swiftra.cliphelper">
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:label="cliphelper" android:allowBackup="false">
        <activity android:name=".Main" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <service android:name=".FillSvc" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_config" />
        </service>
        <service android:name=".CredSvc" android:exported="true" android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter><action android:name="android.service.credentials.CredentialProviderService" /></intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/credential_provider" />
        </service>
    </application>
</manifest>

     /** @see LocaleManager#getSearchEnginesForPromoDialog  */
     public List<TemplateUrl> getSearchEnginesForPromoDialog(@SearchEnginePromoType int promoType) {
-        throw new IllegalStateException(
-                "Not applicable unless existing or new promos are required");
+        if (promoType != SearchEnginePromoType.SHOW_EXISTING
+                && promoType != SearchEnginePromoType.SHOW_NEW) {
+            throw new IllegalStateException(
+                    "Not applicable unless existing or new promos are required");
+        }
+        // Swiftra: the prepopulated engines of the user's country (the same set Settings > Search
+        // engine lists first). Starter pack entries (@bookmarks, @history, @tabs) are excluded.
+        TemplateUrlService templateUrlService =
+                TemplateUrlServiceFactory.getForProfile(ProfileManager.getLastUsedRegularProfile());
+        List<TemplateUrl> engines = new ArrayList<>();
+        for (TemplateUrl templateUrl : templateUrlService.getTemplateUrls()) {
+            if (templateUrl.getPrepopulatedId() > 0 && templateUrl.getStarterPackId() == 0) {
+                engines.add(templateUrl);
+            }
+        }
+        if (engines.isEmpty()) {
+            // Never leave the chooser without an option (its confirm button needs a selection).
+            TemplateUrl current = templateUrlService.getDefaultSearchEngineTemplateUrl();
+            if (current != null) engines.add(current);
+        }
+        return engines;
     }
 

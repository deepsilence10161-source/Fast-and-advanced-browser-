+    /**
+     * Swiftra: every user picks the default search engine once, in every region (Chrome on Android
+     * pre-selects it outside the OS choice screen). Shown as the First Run page
+     * (FirstRunFlowSequencer.shouldShowSearchEnginePage) or, if First Run did not show it, as the
+     * DefaultSearchEngineDialogCoordinator dialog on the next launch. The engines are the
+     * prepopulated engines of the user's country and DefaultSearchEngineDialogHelper shuffles them,
+     * so no engine is pre-selected or placed first. Settings > Search engine still changes it later.
+     * Not shown again once a choice is confirmed (SearchEnginePromoState.CHECKED_AND_SHOWN), nor a
+     * second time in a session where the dialog was dismissed, nor in retail demo mode or when the
+     * default search engine is set by policy.
+     */
+    private @SearchEnginePromoType int getSwiftraSearchChoiceShowType() {
+        if (mSearchEnginePromoCompleted || mSearchEnginePromoShownThisSession) {
+            return SearchEnginePromoType.DONT_SHOW;
+        }
+        if (DeviceInfo.isRetailDemoMode()) return SearchEnginePromoType.DONT_SHOW;
+        if (LibraryLoader.getInstance().isInitialized() && ProfileManager.isInitialized()) {
+            TemplateUrlService templateUrlService =
+                    TemplateUrlServiceFactory.getForProfile(
+                            ProfileManager.getLastUsedRegularProfile());
+            if (templateUrlService.isLoaded() && templateUrlService.isDefaultSearchManaged()) {
+                return SearchEnginePromoType.DONT_SHOW;
+            }
+        }
+        return SearchEnginePromoType.SHOW_EXISTING;
+    }

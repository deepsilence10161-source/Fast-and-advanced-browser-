+
+    /**
+     * Swiftra update channel (patch 0020). Reads swiftra-update.json + .sig from the project's rolling
+     * public release, at most once per 24 h (1 h after a failure), from a background thread.
+     * The manifest is accepted only if its ECDSA P-256 signature over "swiftra-update-v1\n" + bytes
+     * verifies with the embedded public key (the Swiftra Shield list key; private key never in source).
+     * An update is offered when the manifest entry for this device's ABI was published after this APK
+     * was installed. The URL must point into the project's GitHub releases; Android's package
+     * installer then only accepts an APK signed with the same Swiftra certificate.
+     * Plain HTTPS GET, no cookies or identifiers.
+     */
+    /**
+     * Swiftra (patch 0020): a signed update manifest was fetched and verified in the last 48 h, so
+     * "no update available" is a real answer (used by Safety check, patch 0005).
+     */
+    public static boolean swiftraCheckedRecently() {
+        long ok = ContextUtils.getAppSharedPreferences().getLong(SwiftraUpdate.PREF_LAST_OK, 0);
+        long now = System.currentTimeMillis();
+        return ok > 0 && ok <= now && now - ok < SwiftraUpdate.RECENT_MS;
+    }
+
+    /** An update offer from the signed Swiftra manifest (patch 0020). */
+    static final class SwiftraOffer {
+        final String url;
+        final String id;
+
+        SwiftraOffer(String url, String id) {
+            this.url = url;
+            this.id = id;
+        }
+    }
+
+    static final class SwiftraUpdate {
+        private static final String TAG = "SwiftraUpdate";
+        static final String RELEASES =
+                "https://github.com/deepsilence10161-source/Fast-and-advanced-browser-/releases/";
+        static final String MANIFEST_URL = RELEASES + "latest/download/swiftra-update.json";
+        static final String SIG_URL = MANIFEST_URL + ".sig";
+        static final String PUBLIC_KEY =
+                "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEbVLbrurOPDexJAjk35SxmUID+BH6Z1ECuzPWudrdCg2UJKB832p2zBMi3Z59GsMOpMmjWv5z9YAt3Qdigb6ZTA==";
+        static final byte[] DOMAIN = "swiftra-update-v1\n".getBytes(StandardCharsets.US_ASCII);
+        private static final long CHECK_EVERY_MS = 24L * 3600 * 1000;
+        private static final long RETRY_AFTER_FAILURE_MS = 3600L * 1000;
+        private static final int MAX_BYTES = 64 * 1024;
+        private static final String PREF_LAST_TRY = "swiftra_update_last_try_ms";
+        private static final String PREF_MANIFEST = "swiftra_update_manifest";
+        static final String PREF_LAST_OK = "swiftra_update_last_ok_ms";
+        static final long RECENT_MS = 48L * 3600 * 1000;
+        static final String TEST_SWITCH = "swiftra-update-manifest-url";
+
+        /** Test-only manifest location (E2E): honoured only from the command-line file, which needs adb/root. */
+        static @Nullable String testManifestUrl() {
+            if (!CommandLine.isInitialized()) return null;
+            String u = CommandLine.getInstance().getSwitchValue(TEST_SWITCH);
+            if (u == null) return null;
+            return u.startsWith("https://") || u.startsWith("http://127.0.0.1:") ? u : null;
+        }
+
+        static @Nullable SwiftraOffer check() {
+            String test = testManifestUrl();
+            if (test != null) {
+                // E2E: no rate limit, no cache; the signature and URL rules are the same.
+                try {
+                    byte[] json = download(test, true);
+                    byte[] sig = download(test + ".sig", true);
+                    if (!verify(json, sig)) throw new IOException("bad signature");
+                    Log.w(TAG, "test manifest verified");
+                    return offerFrom(new String(json, StandardCharsets.UTF_8), abi(), installTimeMs());
+                } catch (IOException e) {
+                    Log.w(TAG, "test manifest rejected: %s", e.getMessage());
+                    return null;
+                }
+            }
+            SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+            long now = System.currentTimeMillis();
+            long last = prefs.getLong(PREF_LAST_TRY, 0);
+            if (now - last >= CHECK_EVERY_MS || now < last) {
+                prefs.edit().putLong(PREF_LAST_TRY, now - CHECK_EVERY_MS + RETRY_AFTER_FAILURE_MS).apply();
+                try {
+                    byte[] json = download(MANIFEST_URL, false);
+                    byte[] sig = download(SIG_URL, false);
+                    if (!verify(json, sig)) throw new IOException("bad signature");
+                    prefs.edit()
+                            .putString(PREF_MANIFEST, new String(json, StandardCharsets.UTF_8))
+                            .putLong(PREF_LAST_TRY, now)
+                            .putLong(PREF_LAST_OK, now)
+                            .apply();
+                } catch (IOException e) {
+                    Log.w(TAG, "update check failed: %s", e.getMessage());
+                }
+            }
+            String cached = prefs.getString(PREF_MANIFEST, null);
+            return cached == null ? null : offerFrom(cached, abi(), installTimeMs());
+        }
+
+        /** Pure decision: offer only a signed, newer, in-project HTTPS APK for this ABI. */
+        static @Nullable SwiftraOffer offerFrom(String manifest, @Nullable String abi, long installedMs) {
+            if (abi == null || installedMs <= 0) return null;
+            try {
+                JSONObject m = new JSONObject(manifest);
+                if (m.optInt("v") != 1) return null;
+                @Nullable JSONObject apks = m.optJSONObject("apks");
+                @Nullable JSONObject e = apks == null ? null : apks.optJSONObject(abi);
+                if (e == null) return null;
+                String url = e.optString("url");
+                String sha = e.optString("sha256");
+                long published = e.optLong("published_ms");
+                if (!url.startsWith(RELEASES) || url.contains("..") || sha.length() != 64) return null;
+                if (published <= installedMs) return null;
+                return new SwiftraOffer(url, sha.substring(0, 12));
+            } catch (JSONException ex) {
+                return null;
+            }
+        }
+
+        static @Nullable String abi() {
+            String[] abis = Build.SUPPORTED_64_BIT_ABIS;
+            if (abis.length == 0) return null;
+            if ("arm64-v8a".equals(abis[0])) return "arm64";
+            if ("x86_64".equals(abis[0])) return "x64";
+            return null;
+        }
+
+        static long installTimeMs() {
+            try {
+                Context c = ContextUtils.getApplicationContext();
+                PackageInfo pi = c.getPackageManager().getPackageInfo(c.getPackageName(), 0);
+                return pi.lastUpdateTime;
+            } catch (PackageManager.NameNotFoundException e) {
+                return 0;
+            }
+        }
+
+        static boolean verify(byte[] json, byte[] derSig) {
+            try {
+                PublicKey key =
+                        KeyFactory.getInstance("EC")
+                                .generatePublic(
+                                        new X509EncodedKeySpec(
+                                                Base64.getDecoder().decode(PUBLIC_KEY)));
+                Signature v = Signature.getInstance("SHA256withECDSA");
+                v.initVerify(key);
+                v.update(DOMAIN);
+                v.update(json);
+                return v.verify(derSig);
+            } catch (GeneralSecurityException | IllegalArgumentException e) {
+                return false;
+            }
+        }
+
+        private static byte[] download(String url, boolean test) throws IOException {
+            HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+            try {
+                c.setConnectTimeout(15000);
+                c.setReadTimeout(30000);
+                c.setInstanceFollowRedirects(true);
+                c.setUseCaches(false);
+                c.setRequestProperty("User-Agent", "SwiftraUpdate/1");
+                int code = c.getResponseCode();
+                if (code != 200) throw new IOException("HTTP " + code);
+                String proto = c.getURL().getProtocol();
+                boolean loopback = test && "http".equals(proto) && "127.0.0.1".equals(c.getURL().getHost());
+                if (!"https".equals(proto) && !loopback) throw new IOException("non-https");
+                try (InputStream in = c.getInputStream()) {
+                    ByteArrayOutputStream bo = new ByteArrayOutputStream();
+                    byte[] buf = new byte[8192];
+                    int r;
+                    while ((r = in.read(buf)) >= 0) {
+                        bo.write(buf, 0, r);
+                        if (bo.size() > MAX_BYTES) throw new IOException("too large");
+                    }
+                    return bo.toByteArray();
+                }
+            } finally {
+                c.disconnect();
+            }
+        }
+    }

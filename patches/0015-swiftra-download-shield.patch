 bool DownloadProtectionDelegateAndroid::ShouldCheckDownloadUrl(
     download::DownloadItem* item) const {
-  return IsAndroidDownloadProtectionEnabledForDownloadProfile(item);
+  // Swiftra Download Shield: the URL chain check is answered by the on-device
+  // Swiftra Shield list (RemoteSafeBrowsingDatabaseManager::CheckDownloadUrl),
+  // so it runs whenever Safe Browsing is on. It does not depend on
+  // kMaliciousApkDownloadCheck, which only gates the server ping
+  // (MayCheckClientDownload stays unchanged: no ClientDownloadRequest is sent).
+  if (!item) {
+    return false;

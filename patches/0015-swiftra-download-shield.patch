+RemoteSafeBrowsingDatabaseManager::ClientRequest::ClientRequest(
+    Client* client,
+    RemoteSafeBrowsingDatabaseManager* db_manager,
+    std::vector<GURL> url_chain)
+    : client_(client),
+      db_manager_(db_manager),
+      is_download_(true),
+      url_chain_(std::move(url_chain)) {}
+
+bool RemoteSafeBrowsingDatabaseManager::ClientRequest::
+    StartNextDownloadCheck() {
+  while (next_download_index_ < url_chain_.size()) {
+    const GURL& next = url_chain_[next_download_index_++];
+    if (!db_manager_->CanCheckUrl(next)) {
+      continue;
+    }
+    url_ = next;
+    SafeBrowsingApiHandlerBridge::GetInstance().StartHashDatabaseUrlCheck(
+        base::BindOnce(&ClientRequest::OnRequestDone, GetWeakPtr()), next,
+        CreateSBThreatTypeSet({SBThreatType::SB_THREAT_TYPE_URL_MALWARE,
+                               SBThreatType::SB_THREAT_TYPE_URL_PHISHING,
+                               SBThreatType::SB_THREAT_TYPE_URL_UNWANTED}));
+    return true;
+  }
+  return false;
+}
+
+void RemoteSafeBrowsingDatabaseManager::ClientRequest::ReportSafeOnStop() {
+  if (is_download_) {
+    client_->OnCheckDownloadUrlResult(url_chain_,
+                                      SBThreatType::SB_THREAT_TYPE_SAFE);
+    return;
+  }
+  OnRequestDone(SBThreatType::SB_THREAT_TYPE_SAFE, ThreatMetadata());
+}
+
 void RemoteSafeBrowsingDatabaseManager::ClientRequest::OnRequestDone(
     SBThreatType matched_threat_type,
     const ThreatMetadata& metadata) {
   DVLOG(1) << "OnRequestDone took " << timer_.Elapsed().InMilliseconds()
            << " ms for client " << client_ << " and URL " << url_;
+  if (is_download_) {
+    if (matched_threat_type == SBThreatType::SB_THREAT_TYPE_SAFE &&
+        StartNextDownloadCheck()) {
+      return;  // The next URL of the chain is being checked.
+    }
+    // Any Shield hit (malware, phishing or unwanted) on any URL of the chain
+    // makes the download dangerous. DownloadUrlSBClient::IsDangerous() only
+    // accepts SB_THREAT_TYPE_URL_BINARY_MALWARE.
+    client_->OnCheckDownloadUrlResult(
+        url_chain_, matched_threat_type == SBThreatType::SB_THREAT_TYPE_SAFE
+                        ? SBThreatType::SB_THREAT_TYPE_SAFE
+                        : SBThreatType::SB_THREAT_TYPE_URL_BINARY_MALWARE);
+    // CancelCheck() will delete *this.
+    db_manager_->CancelCheck(client_);
+    return;
+  }
   if (is_subresource_filter_) {
     client_->OnCheckSubresourceFilterUrlResult(
         url_, matched_threat_type, metadata.subresource_filter_match);

+  // Swiftra Download Shield: upstream skips this check on Android (no local
+  // blocklist). Swiftra has one on the device (Swiftra Shield), so every URL of
+  // the chain (redirects included) is checked; nothing leaves the device.
+  DCHECK(ui_task_runner()->RunsTasksInCurrentSequence());
+  if (!enabled_) {
+    return true;
+  }
+  auto req = std::make_unique<ClientRequest>(client, this, url_chain);
+  if (!req->StartNextDownloadCheck()) {
+    return true;  // No checkable URL: safe, continue right away.
+  }
+  current_requests_.push_back(std::move(req));
+  // Defer the download.
+  return false;
 }
 

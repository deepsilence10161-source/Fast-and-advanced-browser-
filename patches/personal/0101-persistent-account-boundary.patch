+// found in the LICENSE file.
+
+package org.chromium.components.signin;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+
+import org.chromium.base.Callback;
+import org.chromium.base.Promise;
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.signin.base.AccountCapabilities;
+import org.chromium.components.signin.base.AccountInfo;
+import org.chromium.components.signin.base.CoreAccountInfo;
+import org.chromium.google_apis.gaia.CoreAccountId;
+import org.chromium.google_apis.gaia.GoogleServiceAuthError;
+import org.chromium.google_apis.gaia.GoogleServiceAuthErrorState;
+
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * No-platform-account backend for the separate persistent personal source variant.
+ *
+ * <p>No delegate, device account, token service, observer receiver, profile or file is accessed.
+ * Website sessions remain in the normal browser profile; no sign-out or deletion is performed.
+ * This boundary does not disable every credential, autofill, intent or network surface.
+ */
+@NullMarked
+public final class BrowserContainedAccountManagerFacade implements AccountManagerFacade {
+    @Override
+    public void addObserver(AccountsChangeObserver observer) {
+        ThreadUtils.assertOnUiThread();
+        // The immutable empty local roster never changes; do not register an OS observer.
+    }
+
+    @Override
+    public void removeObserver(AccountsChangeObserver observer) {
+        ThreadUtils.assertOnUiThread();
+    }
+
+    @Override
+    public Promise<List<AccountInfo>> getAccounts() {
+        ThreadUtils.assertOnUiThread();
+        return Promise.fulfilled(Collections.emptyList());
+    }
+
+    @Override
+    public void getAccessToken(
+            CoreAccountInfo account, String scope, GetAccessTokenCallback callback) {
+        ThreadUtils.assertOnUiThread();
+        callback.onGetTokenFailure(
+                new GoogleServiceAuthError(GoogleServiceAuthErrorState.REQUEST_CANCELED));
+    }
+
+    @Override
+    public void invalidateAccessToken(String token, @Nullable Runnable completedRunnable) {
+        ThreadUtils.assertOnUiThread();
+        // There is no external token to revoke. Do not forward the supplied value anywhere.
+        if (completedRunnable != null) completedRunnable.run();
+    }
+
+    @Override
+    public void waitForPendingTokenRequestsToComplete(Runnable callback) {
+        ThreadUtils.assertOnUiThread();
+        callback.run();
+    }
+
+    @Override
+    public void checkIsSubjectToParentalControls(
+            CoreAccountInfo account, ChildAccountStatusListener listener) {
+        ThreadUtils.assertOnUiThread();
+        // No platform account exists in this backend; do not classify the supplied account.
+        listener.onStatusReady(false, null);
+    }
+
+    @Override
+    public Promise<AccountCapabilities> getAccountCapabilities(CoreAccountInfo account) {
+        ThreadUtils.assertOnUiThread();
+        // Empty means unknown, not a fabricated affirmative capability or hanging request.
+        return Promise.fulfilled(new AccountCapabilities(new String[0], new boolean[0]));
+    }
+
+    @Override
+    public void createAddAccountIntent(
+            @Nullable String prefilledEmail, Callback<@Nullable Intent> callback) {
+        // This entry point is AnyThread. Preserve its main-thread callback contract.
+        PostTask.postTask(TaskTraits.UI_DEFAULT, () -> callback.onResult(null));
+    }
+
+    @Override
+    public void updateCredentials(
+            CoreAccountId accountId, Activity activity, @Nullable Callback<Boolean> callback) {
+        ThreadUtils.assertOnUiThread();
+        if (callback != null) callback.onResult(false);
+    }
+
+    @Override
+    public void confirmCredentials(
+            CoreAccountId accountId, @Nullable Activity activity,
+            Callback<@Nullable Bundle> callback) {
+        ThreadUtils.assertOnUiThread();
+        callback.onResult(null);
+    }
+
+    @Override
+    public boolean didAccountFetchSucceed() {
+        // The local empty roster is complete; no platform fetch was attempted or succeeded.
+        return true;
+    }
+
+    @Override
+    public void disallowTokenRequestsForTesting() {
+        ThreadUtils.assertOnUiThread();
+        // Already disallowed for the entire lifetime of this source variant.
+    }
+}

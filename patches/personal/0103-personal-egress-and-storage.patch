+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.ui.base;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.url.GURL;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Browser-process clipboard: never acquires Android's ClipboardManager or a URI provider.
+ *
+ * <p>This is a process-local buffer, not durable profile storage. It is not cleared on focus loss
+ * and does not change/delete cookies, history, drafts or other retained profile files. Text/HTML,
+ * custom text formats and raw PNG bytes are supported. URI/file clipboard operations inherited
+ * from the base class remain unavailable; no external content is read or granted.
+ *
+ * <p>Native Android text widgets/IME and other IPC paths require separate containment review.
+ */
+@NullMarked
+public final class BrowserContainedClipboard extends Clipboard {
+    private static final String PLAIN = "text/plain";
+    private static final String HTML = "text/html";
+    private static final String URI_LIST = "text/uri-list";
+    private static final String PNG = "image/png";
+
+    private Map<String, String> mText = Collections.emptyMap();
+    private byte @Nullable [] mPng;
+    private long mModified;
+
+    private void replace(Map<String, String> text, byte @Nullable [] png) {
+        synchronized (this) {
+            mText = Collections.unmodifiableMap(new HashMap<>(text));
+            mPng = png == null ? null : png.clone();
+            mModified = Math.max(System.currentTimeMillis(), mModified + 1);
+        }
+        // Native browser notification only; deliberately outside the Java monitor.
+        notifyPrimaryClipChanged();
+    }
+
+    @Override
+    public synchronized @Nullable String getCoercedText() {
+        return mText.get(PLAIN);
+    }
+
+    @Override
+    protected synchronized boolean hasCoercedText() {
+        return mText.containsKey(PLAIN);
+    }
+
+    @Override
+    protected synchronized @Nullable String getHTMLText() {
+        return mText.get(HTML);
+    }
+
+    @Override
+    public synchronized boolean hasHTMLOrStyledText() {
+        return mText.containsKey(HTML);
+    }
+
+    @Override
+    synchronized boolean hasUrl() {
+        return getUrl() != null;
+    }
+
+    @Override
+    synchronized @Nullable String getUrl() {
+        String text = mText.get(URI_LIST);
+        if (text == null) text = mText.get(PLAIN);
+        if (text == null || !(text.startsWith("https://") || text.startsWith("http://"))) {
+            return null;
+        }
+        for (int i = 0; i < text.length(); ++i) {
+            if (Character.isWhitespace(text.charAt(i))) return null;
+        }
+        return text;
+    }
+
+    @Override
+    public synchronized byte @Nullable [] getPng() {
+        return mPng == null ? null : mPng.clone();
+    }
+
+    @Override
+    public synchronized boolean hasImage() {
+        return mPng != null;
+    }
+
+    @Override
+    public void setText(String text) {
+        replace(Collections.singletonMap(PLAIN, text), null);
+    }
+
+    @Override
+    public void setText(String label, String text) {
+        setText(text);
+    }
+
+    @Override
+    public void setText(String label, String text, boolean notifyOnSuccess) {
+        setText(text);
+    }
+
+    @Override
+    void setHTMLText(String html, String text) {
+        Map<String, String> values = new HashMap<>();
+        values.put(PLAIN, text);
+        values.put(HTML, html);
+        replace(values, null);
+    }
+
+    @Override
+    protected void setClipboardText(Map<String, String> values) {
+        replace(values, null);
+    }
+
+    @Override
+    protected synchronized boolean hasClipboardDataForMimeType(String mimeType) {
+        return mText.containsKey(mimeType) || (PNG.equals(mimeType) && mPng != null);
+    }
+
+    @Override
+    protected synchronized @Nullable String getCustomClipData(String mimeType) {
+        return mText.get(mimeType);
+    }
+
+    @Override
+    public void setPassword(String password) {
+        // No system clipboard or third-party password provider receives this value.
+        setText(password);
+    }
+
+    @Override
+    public void setImage(byte[] imageData, String extension) {
+        // Never call ImageFileProvider, create a file or grant a content URI.
+        if (imageData.length < 8
+                || (imageData[0] & 0xff) != 137 || imageData[1] != 80
+                || imageData[2] != 78 || imageData[3] != 71
+                || imageData[4] != 13 || imageData[5] != 10
+                || imageData[6] != 26 || imageData[7] != 10) {
+            return;
+        }
+        replace(Collections.emptyMap(), imageData);
+    }
+
+    @Override
+    protected void clear() {
+        // An explicit clipboard API operation, NOT a profile/lifecycle auto-wipe.
+        replace(Collections.emptyMap(), null);
+    }
+
+    @Override
+    public void copyUrlToClipboard(GURL url) {
+        Map<String, String> values = new HashMap<>();
+        values.put(PLAIN, url.getSpec());
+        values.put(URI_LIST, url.getSpec());
+        replace(values, null);
+    }
+
+    @Override
+    public synchronized long getLastModifiedTimeMs() {
+        return mModified;
+    }
+
+    @Override
+    public synchronized boolean canPaste() {
+        return !mText.isEmpty() || mPng != null;
+    }
+
+    @Override
+    public boolean canCopy() {
+        return true;
+    }
+}

+package org.chromium.chrome.browser.browsing_data;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.base.PathUtils;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.chrome.browser.app.tabwindow.TabWindowManagerSingleton;
+import org.chromium.chrome.browser.tabpersistence.TabStateDirectory;
+import org.chromium.chrome.browser.tabwindow.TabWindowManager;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Swiftra: after "Delete browsing data" also overwrites and removes the leftover copies of visited
+ * URLs that Chrome keeps outside the History database: session-restore files, saved state of tabs
+ * that are no longer open, and the multi-window summary. Tabs that are still open keep their state
+ * (they are open, not deleted history). Overwriting a file cannot reach flash blocks that the
+ * storage layer already remapped; it only removes the easy-to-recover copy.
+ */
+final class SwiftraDeleteScrub {
+    private static final String TAG = "SwiftraScrub";
+    private static final Pattern TAB_FILE = Pattern.compile("^(?:flatbufferv1_)?tab(\\d+)$");
+
+    private SwiftraDeleteScrub() {}
+
+    /** Must be called on the UI thread after a clear finished. Never throws. */
+    static void run() {
+        try {
+            final List<File> victims = new ArrayList<>();
+
+            File tabsDir = TabStateDirectory.getOrCreateTabbedModeStateDirectory();
+            String[] names = tabsDir.list();
+            TabWindowManager manager = TabWindowManagerSingleton.getInstance();
+            if (names != null && manager.isAllTabStateInitialized()) {
+                for (String name : names) {
+                    Matcher m = TAB_FILE.matcher(name);
+                    if (!m.matches()) continue;
+                    int id = Integer.parseInt(m.group(1));
+                    if (manager.canTabStateBeDeleted(id)) victims.add(new File(tabsDir, name));
+                }
+            }
+
+            File sessions = new File(PathUtils.getDataDirectory(), "Default/Sessions");
+            File[] sessionFiles = sessions.listFiles();
+            if (sessionFiles != null) {
+                for (File f : sessionFiles) victims.add(f);
+            }
+
+            File multiInstance = ContextUtils.getApplicationContext().getDir("multi_instance", 0);
+            victims.add(new File(multiInstance, "multi_instance_data.pb"));
+
+            Log.i(TAG, "scrub queued for %d files", victims.size());
+            PostTask.postTask(
+                    TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                    () -> {
+                        for (File f : victims) wipe(f);
+                    });
+        } catch (RuntimeException e) {
+            Log.w(TAG, "scrub skipped: %s", e.getClass().getSimpleName());
+        }
+    }
+
+    private static void wipe(File file) {
+        try {
+            if (!file.isFile()) return;
+            long left = file.length();
+            if (left > 0) {
+                try (RandomAccessFile raf = new RandomAccessFile(file, "rw")) {
+                    byte[] zeros = new byte[(int) Math.min(left, 65536L)];
+                    raf.seek(0);
+                    while (left > 0) {
+                        int n = (int) Math.min(left, (long) zeros.length);
+                        raf.write(zeros, 0, n);
+                        left -= n;
+                    }
+                    raf.getFD().sync();
+                }
+            }
+        } catch (IOException | RuntimeException e) {
+            // Fall through: still try to unlink.
+        }
+        file.delete();
+    }
+}

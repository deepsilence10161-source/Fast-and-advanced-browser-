+#if BUILDFLAG(IS_ANDROID)
+// Swiftra (patch 0021): OSCrypt key from the Android Keystore. Upstream Android
+// only has PosixKeyProvider, whose "v10" key is a constant in the public
+// source, so cookies and local card data are only obfuscated. This provider
+// returns a random per-install AES-256-GCM key that exists on disk only wrapped
+// by a non-exportable Keystore key (PlayServicesVersionInfo.java). It has a
+// higher precedence than v10, so new data uses it while v10 data stays
+// readable. On any failure it reports kTemporarilyUnavailable and v10 keeps
+// being used, so no data is lost. The Keystore call runs off the UI thread.
+constexpr char kSwiftraKeystoreTag[] = "sw1";
+
+std::vector<uint8_t> SwiftraFetchKeystoreKey() {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto j_key = Java_PlayServicesVersionInfo_swiftraOsCryptKey(env);
+  std::vector<uint8_t> key;
+  if (!j_key.is_null()) {
+    base::android::JavaByteArrayToByteVector(env, j_key, &key);
+  }
+  return key;
+}
+
+class SwiftraKeystoreKeyProvider : public os_crypt_async::KeyProvider {
+ public:
+  SwiftraKeystoreKeyProvider() = default;
+  ~SwiftraKeystoreKeyProvider() override = default;
+
+  void GetKey(KeyCallback callback) override {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&SwiftraFetchKeystoreKey),
+        base::BindOnce(&SwiftraKeystoreKeyProvider::OnKey,
+                       std::move(callback)));
+  }
+
+  bool UseForEncryption() override { return true; }
+
+ private:
+  static void OnKey(KeyCallback callback, std::vector<uint8_t> raw) {
+    if (raw.size() != 32u) {
+      std::move(callback).Run(
+          kSwiftraKeystoreTag,
+          base::unexpected(KeyError::kTemporarilyUnavailable));
+      return;
+    }
+    os_crypt_async::Encryptor::Key key(
+        raw, os_crypt_async::mojom::Algorithm::kAES256GCM);
+    std::move(callback).Run(kSwiftraKeystoreTag, std::move(key));
+  }
+};
+#endif  // BUILDFLAG(IS_ANDROID)

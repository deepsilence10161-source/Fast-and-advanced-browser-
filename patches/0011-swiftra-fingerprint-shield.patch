+// Copyright 2026 The Swiftra Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#if defined(UNSAFE_BUFFERS_BUILD)
+// Raw pixel / sample loops below are bounds-checked by hand.
+#pragma allow_unsafe_buffers
+#endif
+
+#include "third_party/blink/renderer/core/frame/swiftra_fingerprint_shield.h"
+
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/numerics/checked_math.h"
+#include "base/rand_util.h"
+#include "cc/paint/paint_image.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/execution_context/security_context.h"
+#include "third_party/blink/renderer/core/frame/frame.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/workers/worker_global_scope.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+
+BASE_FEATURE(kSwiftraFingerprintShield, base::FEATURE_ENABLED_BY_DEFAULT);
+
+namespace {
+
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325ull;
+constexpr uint64_t kFnvPrime = 0x100000001b3ull;
+
+uint64_t Mix(uint64_t z) {
+  z += 0x9e3779b97f4a7c15ull;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+  return z ^ (z >> 31);
+}
+
+uint64_t HashString(uint64_t h, const String& s) {
+  for (wtf_size_t i = 0; i < s.length(); ++i) {
+    h ^= static_cast<uint64_t>(s[i]);
+    h *= kFnvPrime;
+  }
+  h ^= 0xff;
+  h *= kFnvPrime;
+  return h;
+}
+
+// One random value per renderer process: the noise changes every session.
+uint64_t SessionSalt() {
+  static const uint64_t salt = base::RandUint64();
+  return salt;
+}
+
+const SecurityOrigin* TopLevelOrigin(ExecutionContext* context) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      if (Frame* top = frame->Top()) {
+        if (const SecurityContext* security = top->GetSecurityContext()) {
+          if (const SecurityOrigin* origin = security->GetSecurityOrigin()) {
+            return origin;
+          }
+        }
+      }
+    }
+    return window->GetSecurityOrigin();
+  }
+  if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    if (const SecurityOrigin* origin =
+            worker->top_level_frame_security_origin()) {
+      return origin;
+    }
+  }
+  return context->GetSecurityOrigin();
+}
+
+}  // namespace
+
+uint64_t SwiftraFingerprintKey(ExecutionContext* context) {
+  if (!context || !base::FeatureList::IsEnabled(kSwiftraFingerprintShield)) {
+    return 0;
+  }
+  uint64_t h = kFnvOffset;
+  const SecurityOrigin* origin = TopLevelOrigin(context);
+  if (!origin || origin->IsOpaque()) {
+    h = HashString(h, String("opaque"));
+  } else {
+    String site = origin->RegistrableDomain();
+    if (site.empty()) {
+      site = origin->Host();
+    }
+    h = HashString(HashString(h, origin->Protocol()), site);
+  }
+  return Mix(SessionSalt() ^ h) | 1;
+}
+
+void SwiftraNoiseRGBA8(uint64_t key,
+                       uint8_t* data,
+                       size_t capacity,
+                       int width,
+                       int height,
+                       size_t row_bytes,
+                       int x0,
+                       int y0,
+                       bool bgra) {
+  if (!key || !data || width <= 0 || height <= 0) {
+    return;
+  }
+  base::CheckedNumeric<size_t> needed = static_cast<size_t>(height - 1);
+  needed *= row_bytes;
+  needed += static_cast<size_t>(width) * 4;
+  if (!needed.IsValid() || needed.ValueOrDie() > capacity ||
+      row_bytes < static_cast<size_t>(width) * 4) {
+    return;
+  }
+  const int r = bgra ? 2 : 0;
+  const int b = bgra ? 0 : 2;
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = data + static_cast<size_t>(y) * row_bytes;
+    for (int x = 0; x < width; ++x) {
+      uint8_t* p = row + static_cast<size_t>(x) * 4;
+      if (p[3] != 255) {
+        continue;  // transparent / anti-aliased edges stay exact
+      }
+      const uint64_t color = static_cast<uint64_t>(p[r] & 0xfe) |
+                             (static_cast<uint64_t>(p[1] & 0xfe) << 8) |
+                             (static_cast<uint64_t>(p[b] & 0xfe) << 16);
+      const uint64_t pos =
+          (static_cast<uint64_t>(static_cast<uint32_t>(x0 + x)) << 32) |
+          static_cast<uint32_t>(y0 + y);
+      const uint64_t h = Mix(Mix(pos) ^ color ^ key);
+      if ((h & 0xf) != 0) {
+        continue;
+      }
+      const uint64_t pick = (h >> 8) % 3;
+      const int index = pick == 0 ? r : (pick == 1 ? 1 : b);
+      p[index] = static_cast<uint8_t>((p[index] & 0xfe) | ((h >> 16) & 1));
+    }
+  }
+}
+
+void SwiftraNoisePixmap(uint64_t key,
+                        const SkPixmap& pixmap,
+                        int x0,
+                        int y0) {
+  const SkColorType type = pixmap.colorType();
+  if (!key || !pixmap.addr() ||
+      (type != kRGBA_8888_SkColorType && type != kBGRA_8888_SkColorType)) {
+    return;
+  }
+  SwiftraNoiseRGBA8(key, static_cast<uint8_t*>(pixmap.writable_addr()),
+                    pixmap.computeByteSize(), pixmap.width(), pixmap.height(),
+                    pixmap.rowBytes(), x0, y0,
+                    type == kBGRA_8888_SkColorType);
+}
+
+scoped_refptr<StaticBitmapImage> SwiftraNoisedSnapshot(
+    uint64_t key,
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!key || !image) {
+    return image;
+  }
+  PaintImage paint_image = image->PaintImageForCurrentFrame();
+  if (!paint_image || paint_image.IsPaintWorklet()) {
+    return image;
+  }
+  const SkImageInfo source_info = paint_image.GetSkImageInfo();
+  const SkColorType type = source_info.colorType();
+  if (source_info.isEmpty() ||
+      (type != kRGBA_8888_SkColorType && type != kBGRA_8888_SkColorType &&
+       type != kRGB_888x_SkColorType)) {
+    return image;
+  }
+  const SkImageInfo info =
+      SkImageInfo::Make(source_info.dimensions(), kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType, source_info.refColorSpace());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info) ||
+      !paint_image.readPixels(info, bitmap.getPixels(), bitmap.rowBytes(), 0,
+                              0)) {
+    return image;
+  }
+  SwiftraNoisePixmap(key, bitmap.pixmap(), 0, 0);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(bitmap.asImage(),
+                                                image->Orientation());
+}
+
+void SwiftraNoiseAudio(uint64_t key,
+                       float* samples,
+                       size_t count,
+                       uint32_t channel) {
+  if (!key || !samples) {
+    return;
+  }
+  // Per-site gain in (-2^-16, 2^-16) plus +-2^-18 per-sample jitter.
+  const double gain =
+      1.0 + (static_cast<double>(Mix(key) >> 11) / 9007199254740992.0 - 0.5) *
+                (2.0 / 65536.0);
+  for (size_t i = 0; i < count; ++i) {
+    const uint64_t h =
+        Mix(key ^ Mix((static_cast<uint64_t>(channel) << 40) ^ i));
+    const double jitter = (h & 1) ? (1.0 / 262144.0) : (-1.0 / 262144.0);
+    samples[i] = static_cast<float>(samples[i] * (gain + jitter));
+  }
+}
+
+}  // namespace blink

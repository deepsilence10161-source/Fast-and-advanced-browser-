+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SWIFTRA_FINGERPRINT_SHIELD_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SWIFTRA_FINGERPRINT_SHIELD_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "base/feature_list.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+class SkPixmap;
+
+namespace blink {
+
+class ExecutionContext;
+class StaticBitmapImage;
+
+// Swiftra fingerprint shield: canvas / WebGL / OfflineAudio readbacks get a
+// tiny, invisible perturbation that is
+//  * different for every top-level site and every browser session, so the
+//    same device does not produce the same fingerprint on two sites;
+//  * stable within a site and session, so repeated reads agree;
+//  * idempotent for pixels (only the lowest bit of one colour channel of
+//    about 1 in 16 opaque pixels is set from a hash of the pixel's position
+//    and its other bits), so read -> putImageData -> read cannot strip it.
+// Disable with --disable-features=SwiftraFingerprintShield.
+CORE_EXPORT BASE_DECLARE_FEATURE(kSwiftraFingerprintShield);
+
+// Per (session, top-level site) key; 0 when the shield is off.
+CORE_EXPORT uint64_t SwiftraFingerprintKey(ExecutionContext* context);
+
+// 8-bit RGBA/BGRA pixels; (x0, y0) = position of the first pixel in the
+// source surface. Writes stay within `capacity` bytes.
+CORE_EXPORT void SwiftraNoiseRGBA8(uint64_t key,
+                                   uint8_t* data,
+                                   size_t capacity,
+                                   int width,
+                                   int height,
+                                   size_t row_bytes,
+                                   int x0,
+                                   int y0,
+                                   bool bgra);
+
+// Same, for an 8-bit RGBA/BGRA pixmap (other colour types are left alone).
+CORE_EXPORT void SwiftraNoisePixmap(uint64_t key,
+                                    const SkPixmap& pixmap,
+                                    int x0,
+                                    int y0);
+
+// Returns a perturbed unpremultiplied RGBA copy of an 8-bit `image` (for
+// toDataURL / toBlob / convertToBlob), or `image` itself when key is 0 or the
+// format is not 8-bit.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> SwiftraNoisedSnapshot(
+    uint64_t key,
+    scoped_refptr<StaticBitmapImage> image);
+
+// Rendered audio samples: per-site gain offset below 2^-16 plus per-sample
+// jitter below 2^-18 (inaudible).
+CORE_EXPORT void SwiftraNoiseAudio(uint64_t key,
+                                   float* samples,
+                                   size_t count,
+                                   uint32_t channel);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SWIFTRA_FINGERPRINT_SHIELD_H_

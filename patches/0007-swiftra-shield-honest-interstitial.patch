+// Swiftra: the local hash database is Swiftra Shield, a list Google's
+// real-time service does not know about. Upstream trusts a fresh SAFE
+// real-time verdict and skips the database, which would let a Shield-listed
+// URL through in Enhanced protection while Standard protection blocks it.
+// Consult the database on every SAFE verdict, so the URL is blocked when
+// either source flags it.
+#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
+constexpr bool kAlwaysCheckLocalListOnSafe = false;
+#else
+constexpr bool kAlwaysCheckLocalListOnSafe = true;
+#endif
+

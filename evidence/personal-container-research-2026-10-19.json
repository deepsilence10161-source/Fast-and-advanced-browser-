  "source_findings": [
    {
      "topic": "backup",
      "finding": "manifest template is conditional on backup_key: true plus BackupAgent versus false. Existing project APK audit requires allowBackup=false. No claim current APK has backups enabled."
    },
    {
      "topic": "platform permissions",
      "finding": "template contains account, storage and credential candidate permissions. Declarations are potential surfaces, not proof of runtime exfiltration."
    },
    {
      "topic": "account bridge",
      "finding": "AccountManagerFacadeImpl.createAddAccountIntent delegates a device-account-add intent; actual website signup linkage is not tested."
    },
    {
      "topic": "provider grants",
      "finding": "ChromeFileProvider/DownloadFileProvider have exported=false and grantUriPermissions=true; non-exported alone is not a never-share proof."
    },
    {
      "topic": "IME",
      "finding": "normal non-incognito WebContents permits keyboard learning; no-learning hint is set when allowKeyboardLearning=false. Keyboard enforcement not guaranteed."
    },
    {
      "topic": "external navigation",
      "finding": "ExternalNavigationHandler contains external intent, Play Store and WebAPK paths; actual personal-mode blocking not implemented."
    },
    {
      "topic": "encryption",
      "finding": "existing 0021 OSCrypt wrapping and historical cookie proof do not certify full-profile encryption; v10 fallback must not be accepted as new private-vault fail-closed writes."
    }
  ],
